# ─────────────────────────────────────────────────────────
# Cyber Threat Intelligence Platform - Environment Template
# Copy this file to `.env` and fill in real values.
# Never commit the real .env file.
# ─────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────
APP_NAME=cti-platform
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# ── PostgreSQL ───────────────────────────────────────────
# POSTGRES_PORT is the HOST port mapped to the container.
# If a native PostgreSQL already uses 5432, set this to 5433
# and update DATABASE_URL to match.
# Prefer 127.0.0.1 over "localhost": on some Docker Desktop/WSL setups a relay
# can squat on IPv6 ::1 and drop connections; forcing IPv4 avoids it.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=cti_db
POSTGRES_USER=cti_user
POSTGRES_PASSWORD=change_me_in_production

# Full SQLAlchemy connection URL (built from values above)
DATABASE_URL=postgresql+psycopg2://cti_user:change_me_in_production@localhost:5432/cti_db

# ── Threat Feed API Keys ─────────────────────────────────
# Optional. NVD works without a key but is rate-limited to ~5 req/30s;
# a key raises it to ~50. Request: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
OTX_API_KEY=
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# ── MISP (Phase 9) ───────────────────────────────────────
# Live MISP connector. Leave blank to use the offline sample fixture
# (python -m collectors.misp --sample collectors/fixtures/sample_misp_events.json).
MISP_URL=
MISP_API_KEY=
MISP_SSL_VERIFY=true

# ── Wazuh SOC (Phase 10) ─────────────────────────────────
# Manager API (agents) and Indexer/OpenSearch (alerts). Leave blank to use the
# offline fixture (python -m collectors.wazuh --sample collectors/fixtures/sample_wazuh.json).
WAZUH_API_URL=https://localhost:55000
WAZUH_USERNAME=
WAZUH_PASSWORD=
INDEXER_URL=https://localhost:9200
INDEXER_USERNAME=
INDEXER_PASSWORD=
WAZUH_VERIFY_SSL=false

# ── Neo4j Knowledge Graph (Phase 11) ─────────────────────
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=cti_graph_pass

# ── AI Threat Analyst (Phase 13) ─────────────────────────
# Provider: none | gemini | openai | ollama. "none" => deterministic answers
# grounded in evidence (no LLM credentials required).
AI_PROVIDER=none
AI_MODEL=
AI_TEMPERATURE=0.1
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_URL=http://localhost:11434
# Optional host port overrides for docker-compose:
# NEO4J_HTTP_PORT=7474
# NEO4J_BOLT_PORT=7687

# ── Ticketing connectors (Phase 15.6) ────────────────────
# Provider: mock | jira | thehive | shuffle. "mock" needs no credentials.
TICKET_PROVIDER=mock
JIRA_URL=
JIRA_USER=
JIRA_TOKEN=
JIRA_PROJECT=SOC
THEHIVE_URL=
THEHIVE_API_KEY=
SHUFFLE_URL=
SHUFFLE_API_KEY=
SHUFFLE_WORKFLOW_ID=
SHUFFLE_WEBHOOK_URL=

# ── Orchestration (Phase 18) ─────────────────────────────
# Start the APScheduler cron pipeline on API boot. Off by default so dev/tests
# never auto-run jobs; set true in production deployment.
ORCHESTRATION_ENABLED=false
JOB_MAX_RETRIES=2
JOB_RETRY_BACKOFF_SECONDS=2.0

# ── Dashboard ────────────────────────────────────────────
STREAMLIT_PORT=8501
